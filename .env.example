# Google Gemini（推荐）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI 兼容接口（可选，未设置 GEMINI 时使用）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

API_HOST=0.0.0.0
API_PORT=8000
A2A_API_KEY=dev-local-key
A2A_GATEWAY_URL=http://127.0.0.1:8001

# SQLite 持久化（Task / Artifact / LangGraph Checkpoint）
FINTEAM_DB_PATH=data/finteam.db

# A 股行情 — AKShare / Ashare 免费接口（推荐，无需 Key）
# auto = AKShare → Ashare → iTick(如已配置) → mock
A_SHARE_MARKET_PROVIDER=auto

# 可选：全球市场备用行情（A 股 auto 模式下作为第三备选）
# ITICK_TOKEN=

# 资讯数据 — Finnhub 免费层（公司新闻，A 股映射为 CODE.SS / CODE.SZ）
# 申请地址: https://finnhub.io
FINNHUB_API_KEY=

# 资讯爬虫 — 东方财富个股新闻（默认开启，无需 Key）
NEWS_CRAWLER_ENABLED=true
NEWS_FETCH_DIGEST=true
NEWS_DIGEST_LIMIT=2

# 本地内容缓存 — 优先读 SQLite，超过 N 天自动失效重新拉取
CONTENT_CACHE_TTL_DAYS=90
