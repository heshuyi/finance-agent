# Google Gemini（推荐）
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI 兼容接口（可选，未设置 GEMINI 时使用）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

API_HOST=0.0.0.0
API_PORT=8000
A2A_API_KEY=dev-local-key
A2A_GATEWAY_URL=http://127.0.0.1:8001

# SQLite 持久化（Task / Artifact / LangGraph Checkpoint）
FINTEAM_DB_PATH=data/finteam.db

# A 股行情 — AKShare 开源库聚合公开行情（推荐，无需 Key）
# auto = AKShare → iTick(如已配置) → mock；ashare 需显式指定且仅供备用
A_SHARE_MARKET_PROVIDER=auto

# 可选：全球市场备用行情（A 股 auto 模式下作为备选）
# ITICK_TOKEN=

# 资讯 — 优先使用授权 API（Finnhub 免费层，需申请 Key）
# 申请地址: https://finnhub.io
FINNHUB_API_KEY=

# 第三方资讯公开列表接口 — 默认关闭，个人投研自用需显式开启并自行确认使用条款
NEWS_FETCH_ENABLED=false
# 兼容旧变量名
# NEWS_CRAWLER_ENABLED=false
# 是否抓取资讯正文页摘要 — 默认关闭，且仅限白名单媒体域
NEWS_FETCH_DIGEST=false
NEWS_DIGEST_LIMIT=2

# 法定信息披露 — 巨潮资讯公开查询接口（证监会指定披露平台，默认开启）
FILINGS_FETCH_ENABLED=true

# 公开接口请求限速（秒）
DATA_REQUEST_INTERVAL_SEC=0.5

# 本地内容缓存 — 优先读 SQLite，超过 N 天自动失效重新拉取
CONTENT_CACHE_TTL_DAYS=90
